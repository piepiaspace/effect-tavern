{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/*.d.ts",
    "src/figures/*.ts",
    "src/figures/*.tsx",
    "test/*.ts",
    "test/*.tsx",
    "../server/src/*.d.ts",
    "vite.config.ts"
  ]
}
