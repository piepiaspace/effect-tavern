{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["web/*.ts", "icon/*.ts", "test/*.ts"]
}
