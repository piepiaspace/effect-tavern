---
/**
 * Card — a titled panel, optionally with an icon. With `href`, the whole card
 * is the link.
 *
 * Hit-target / visual-surface separation: the outer `<Tag>` stays stationary so
 * hovering near the bottom edge never oscillates (no hover flicker), while the
 * inner `[data-slot="card-surface"]` carries the subtle lift and shadow.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import BrandIcon, { type BrandIconName } from "@/components/BrandIcon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title?: string;
  /** Iconify icon name (e.g. `ph:lightning`) or Effect Tavern custom icon (`et:timeline`). */
  icon?: string;
  /** Makes the whole card a link. */
  href?: string;
}

const { title, icon, href, class: className, ...attrs } = Astro.props;
const brandIcon = icon?.startsWith("et:") ? (icon.slice(3) as BrandIconName) : null;
const hasIcon = Boolean(icon) || Astro.slots.has("icon");
const hasTitle = Boolean(title) || Astro.slots.has("title");
const Tag = href ? "a" : "article";
// A linked card is named by its link, so its title is not a heading: a row of
// cards under the page title would otherwise skip a heading level.
const Title = href ? "p" : "h3";
---

<Tag
  data-slot="card"
  href={href}
  class={cn(
    "my-4 block rounded-2xl",
    href && "group text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
    className,
  )}
  {...attrs}
>
  <div
    data-slot="card-surface"
    class={cn(
      "h-full rounded-2xl bg-card p-5 shadow-sm ring ring-border",
      href && "transition-[transform,box-shadow] duration-200 ease-out group-hover:-translate-y-0.5 group-hover:shadow-default group-hover:ring-border-strong motion-reduce:group-hover:translate-y-0",
    )}
  >
    {hasIcon && (
      <div data-slot="card-icon" class={cn("mb-3", brandIcon ? "text-foreground" : "text-brand")}>
        <slot name="icon">
          {brandIcon ? (
            <span class="inline-flex size-10 items-center justify-center rounded-xl border border-border bg-background/85">
              <BrandIcon name={brandIcon} class="block size-6" />
            </span>
          ) : (
            icon && <Icon name={icon} class="block size-6" />
          )}
        </slot>
      </div>
    )}
    {hasTitle && (
      <Title data-slot="card-title" class="m-0 text-base font-semibold leading-snug text-foreground">
        <slot name="title">{title}</slot>
      </Title>
    )}
    <div data-slot="card-content" class:list={["text-sm leading-normal text-muted-foreground", hasTitle && "mt-1.5"]}>
      <slot />
    </div>
  </div>
</Tag>
