---
/**
 * BrandIcon — Effect Tavern's bespoke duotone geometric icons (extracted from
 * packages/client/public/brand/custom-icons-sheet-{1,3}.svg). Ink shapes follow
 * `currentColor`; the single focal accent follows `var(--nb-brand)`.
 */
export type BrandIconName =
  | "timeline"
  | "story-card"
  | "template"
  | "layers"
  | "package"
  | "shell";

interface Props {
  name: BrandIconName;
  class?: string;
}

const { name, class: cls = "size-6" } = Astro.props;
---

{name === "timeline" && (
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="120 554 244 244" class={cls} aria-hidden="true">
    <circle cx="242.5" cy="581.9" r="24.46" fill="var(--nb-brand)" />
    <circle cx="323.6" cy="660.8" r="20.99" fill="currentColor" />
    <circle cx="161" cy="680.8" r="22.46" fill="currentColor" />
