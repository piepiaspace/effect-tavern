---
import Logo from "./Logo.astro";
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { config } from "virtual:nimbus/config";
import { getCollectionUrl, getSidebarSections, stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const { collection, showSidebar = true, sections: sectionsProp } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const sidebarSections =
  sectionsProp ?? (await getSidebarSections(currentSlug, { collection }));
// An API reference beside the docs isn't in the docs sidebar, so the docs and
// each reference become the tabs. A reference served at the root is the site.
const apiHrefs = (
  await Promise.all((config.api ?? []).map(async (entry) => ({ entry, href: await getCollectionUrl(entry.collection) })))
).filter(({ href }) => href !== "/");
// The reference the page is in: the longest mount that is the path or a folder of it.
const mountOf = (href: string) => href.replace(/\/$/, "");
const activeApi = apiHrefs
  .filter(({ href }) => currentSlug === mountOf(href) || currentSlug.startsWith(`${mountOf(href)}/`))
  .sort((a, b) => b.href.length - a.href.length)[0];
const sections =
  sidebarSections.length >= 2 || sectionsProp || apiHrefs.length === 0
    ? sidebarSections
    : [
        // A page outside every collection (the 404) is in neither tab.
        { label: "Docs", href: "/", isActive: activeApi === undefined && collection !== undefined },
        ...apiHrefs.map((api) => ({
          label: apiHrefs.length === 1 ? "API reference" : (api.entry.label ?? api.entry.collection),
          href: api.href,
          isActive: api === activeApi,
        })),
      ];
const showSections = sections.length >= 2;
const isZh = collection === "zh" || currentSlug === "/zh" || currentSlug.startsWith("/zh/");
const homeHref = withBase(isZh ? "/zh" : "/", import.meta.env.BASE_URL);
const resolveSectionHref = (href: string): string =>
  withBase(href, import.meta.env.BASE_URL);
const bareSlug = isZh ? (currentSlug.replace(/^\/zh(?=\/|$)/, "") || "/") : currentSlug;
const langSwitchHref = withBase(
  isZh ? bareSlug : (bareSlug === "/" ? "/zh" : `/zh${bareSlug}`),
  import.meta.env.BASE_URL,
);
const langSwitchLabel = isZh ? "EN" : "中文";
const introHref = withBase(isZh ? "/zh/introduction/" : "/introduction/", import.meta.env.BASE_URL);
const conceptsHref = withBase(isZh ? "/zh/concepts/" : "/concepts/", import.meta.env.BASE_URL);
const isHome = currentSlug === "/" || currentSlug === "/zh";
const isConcepts = bareSlug === "/concepts";
const isDocs = !isHome && !isConcepts;
---

<header class="sticky top-0 z-30 bg-background/85 backdrop-blur-md">
  <div class="mx-auto flex items-center justify-between gap-3 h-14 px-4 lg:px-6">
    <div class="flex items-center gap-2.5 min-w-0">
      {showSidebar && (
        <button
          type="button"
          data-sidebar-toggle
          aria-label={isZh ? "折叠或展开侧边栏" : "Toggle sidebar"}
          class="hidden md:inline-flex items-center justify-center w-8 h-8 rounded-full text-muted-foreground hover:text-foreground hover:bg-accent transition-colors cursor-pointer"
        >
          <Icon name="ph:sidebar-simple" class="w-4 h-4" />
        </button>
      )}
      <slot name="brand">
        <a href={homeHref} class="flex shrink-0 items-center gap-2.5 text-foreground no-underline transition-opacity hover:opacity-75">
          <Logo class="h-5 w-5 shrink-0" />
          <span class="text-sm font-semibold tracking-tight">{config.title}</span>
          <span class="hidden sm:inline-flex items-center rounded-full border border-border bg-card px-2 py-0.5 font-mono text-[0.625rem] font-medium tracking-[0.12em] uppercase text-muted-foreground">
            Docs
          </span>
        </a>
      </slot>

      <nav aria-label="Primary" class="hidden md:flex items-center gap-1 ms-3 min-w-0">
        <a
          href={homeHref}
          aria-current={isHome ? "page" : undefined}
          class:list={[
            "px-3 py-1 rounded-full text-[0.8125rem] font-medium no-underline transition-colors shrink-0",
            isHome ? "text-foreground bg-accent" : "text-muted-foreground hover:text-foreground hover:bg-accent/70",
          ]}
        >
          {isZh ? "首页" : "Home"}
        </a>
        <a
          href={introHref}
          aria-current={isDocs ? "page" : undefined}
          class:list={[
            "px-3 py-1 rounded-full text-[0.8125rem] font-medium no-underline transition-colors shrink-0",
            isDocs ? "text-foreground bg-accent" : "text-muted-foreground hover:text-foreground hover:bg-accent/70",
          ]}
        >
          {isZh ? "文档" : "Docs"}
        </a>
        <a
          href={conceptsHref}
          aria-current={isConcepts ? "page" : undefined}
          class:list={[
            "px-3 py-1 rounded-full text-[0.8125rem] font-medium no-underline transition-colors shrink-0",
            isConcepts ? "text-foreground bg-accent" : "text-muted-foreground hover:text-foreground hover:bg-accent/70",
          ]}
        >
          {isZh ? "核心概念" : "Concepts"}
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="actions" />
      <LinkButton
        href={langSwitchHref}
        variant="minimal"
        size="sm"
        aria-label={isZh ? "Switch to English" : "切换到简体中文"}
        class="text-muted-foreground font-medium text-xs px-2"
      >
        {langSwitchLabel}
      </LinkButton>
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
  {/* Phones: the tabs on a row of their own under the bar. */}
  {showSections && (
    <nav aria-label="Sections" data-nb-header-tabs class="md:hidden flex items-center gap-1 h-10 px-4 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {sections.map((section) => (
        <a
          href={resolveSectionHref(section.href)}
          aria-current={section.isActive ? "page" : undefined}
          class:list={[
            "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
            section.isActive
              ? "text-foreground bg-accent"
              : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
          ]}
        >
          {section.label}
        </a>
      ))}
    </nav>
  )}
</header>
