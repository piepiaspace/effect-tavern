{
  "name": "effect-tavern",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
      "vite-plus": "1.8.0"
    }
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "dev": "cd packages/client && bun --bun vp dev",
    "verify": "bun run --filter './packages/*' verify && bun test/install.ts && bun test/release.ts && bun test/mdlint.ts && bun tools/mdlint/index.ts",
    "tavern": "TAVERN_DATA=${TAVERN_DATA:-${DATA:-.dev}} bun packages/server/bin/tavern.ts",
    "docs:dev": "bun --bun --cwd site run dev",
    "docs:build": "bun --bun --cwd site run build",
    "docs:check": "cd site && bunx --bun nimbus-docs check && bun --bun run typecheck && bun --bun run build && bunx --bun nimbus-docs check"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "eslint-plugin-solid": "0.19.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}
